# Shared HMAC secret — retrieve from the Stripe dashboard ("App Secret")
STRIPE_HMAC_SECRET=whsec_...

# Stripe API key — used as the orchestrator bearer token for Provider→Stripe calls
STRIPE_ORCHESTRATOR_TOKEN=sk_...

# Public URL where this provider is hosted (no trailing slash)
PROVIDER_BASE_URL=https://api.toastercloud.dev

# Set to 1 to skip Stripe-Signature verification (development only)
SKIP_SIGNATURE_VERIFICATION=0
